{
  "hosting": {
    "site": "ruta-travel-oficial",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/node_modules/**",
      "*.py",
      "download_ruta_hd.js",
      "extract_*.js",
      "scrape_*.js",
      "trends_*.js",
      "test_*.js",
      "verify_*.js",
      "inspect_*.js",
      "scan_*.js",
      "audit_*.js",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml"
          }
        ]
      },
      {
        "source": "robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ]
      },
      {
        "source": "llms.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      }
    ]
  }
}
